# Frontend (Vite) — copy to .env in project root

# Google OAuth Web Client ID (Google Cloud Console → APIs & Services → Credentials)
# Must match server GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Backend API (leave empty in local dev — Vite proxies /api → http://localhost:8080)
VITE_API_BASE_URL=

# Production example:
# VITE_API_BASE_URL=https://your-api.example.com
